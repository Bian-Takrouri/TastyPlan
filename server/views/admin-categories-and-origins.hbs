<div class="row mb-4">
    <div class="col">
        <h2 class="h3 font-weight-bold text-gray-800">Categories & Origins</h2>
        <p class="text-muted mb-0">Manage system categories and recipe origins.</p>
    </div>
</div>

<div class="row">
    <!-- Categories Column -->
    <div class="col-md-6 mb-4">
        <div class="card shadow">
            <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Categories</h6>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                    <i class="fas fa-plus fa-sm text-white-50 me-1"></i> Add Category
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each categories}}
                            <tr>
                                <td>{{this.id}}</td>
                                <td>
                                    {{#if this.imageUrl}}
                                    <img src="{{this.imageUrl}}" alt="{{this.name}}" class="rounded" style="width: 40px; height: 40px; object-fit: cover;">
                                    {{else}}
                                    <span class="badge bg-secondary">No Image</span>
                                    {{/if}}
                                </td>
                                <td class="fw-bold">{{this.name}}</td>
                                <td class="small text-muted">{{this.description}}</td>
                                <td class="text-center align-middle" style="width: 90px;">
                                    <form action="/admin/categories/delete/{{this.id}}" method="POST" style="display: inline; margin: 0;" onsubmit="return confirm('Delete this category?');">
                                        <button type="submit" class="btn btn-sm btn-danger px-2 py-1 shadow-sm" title="Delete">
                                            <i class="fas fa-trash-alt me-1"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            {{else}}
                            <tr><td colspan="5" class="text-center text-muted py-3">No categories found.</td></tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Origins Column -->
    <div class="col-md-6 mb-4">
        <div class="card shadow">
            <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Origins</h6>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addOriginModal">
                    <i class="fas fa-plus fa-sm text-white-50 me-1"></i> Add Origin
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Flag</th>
                                <th>Name</th>
                                <th>Country</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each origins}}
                            <tr>
                                <td>{{this.id}}</td>
                                <td>
                                    {{#if this.flagUrl}}
                                    <img src="{{this.flagUrl}}" alt="{{this.name}}" class="rounded" style="width: 35px; height: 25px; object-fit: cover;">
                                    {{else}}
                                    <span class="badge bg-secondary">No Flag</span>
                                    {{/if}}
                                </td>
                                <td class="fw-bold">{{this.name}}</td>
                                <td>{{this.country}}</td>
                                <td class="text-center align-middle" style="width: 90px;">
                                    <form action="/admin/origins/delete/{{this.id}}" method="POST" style="display: inline; margin: 0;" onsubmit="return confirm('Delete this origin?');">
                                        <button type="submit" class="btn btn-sm btn-danger px-2 py-1 shadow-sm" title="Delete">
                                            <i class="fas fa-trash-alt me-1"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            {{else}}
                            <tr><td colspan="5" class="text-center text-muted py-3">No origins found.</td></tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/admin/categories/add" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input type="text" name="name" class="form-control" required placeholder="e.g., Seafood">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Image URL</label>
                        <input type="url" name="imageUrl" class="form-control" placeholder="https://example.com/category.jpg">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Category description..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Origin Modal -->
<div class="modal fade" id="addOriginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/admin/origins/add" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Origin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Origin Name / Cuisine</label>
                        <input type="text" name="name" class="form-control" required placeholder="e.g., Italian">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Country</label>
                        <input type="text" name="country" class="form-control" placeholder="e.g., Italy">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Flag Image URL</label>
                        <input type="url" name="flagUrl" class="form-control" placeholder="https://example.com/flag.png">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Origin</button>
                </div>
            </form>
        </div>
    </div>
</div>