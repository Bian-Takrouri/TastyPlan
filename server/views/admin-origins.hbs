<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title mb-1">Origin Management</h2>
        <p class="text-muted mb-0">Add, edit, or remove recipe origins.</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addOriginModal">
        <i class="fas fa-plus me-1"></i> Add Origin
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold">All Origins</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Flag</th>
                        <th>Name</th>
                        <th>Country</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each origins}}
                    <tr>
                        <td>{{add @index 1}}</td>
                        <td>
                            {{#if this.flagUrl}}
                                <img src="{{this.flagUrl}}" alt="{{this.name}}" class="rounded" style="width:40px;height:28px;object-fit:cover;">
                            {{else}}
                                <span class="badge bg-secondary">No Flag</span>
                            {{/if}}
                        </td>
                        <td class="fw-bold">{{this.name}}</td>
                        <td>{{this.country}}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-warning me-1" data-bs-toggle="modal" data-bs-target="#editOriginModal{{this._id}}">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <form action="/admin/origins/delete/{{this._id}}" method="POST" class="d-inline" onsubmit="return confirm('Delete this origin?');">
                                <button type="submit" class="btn btn-sm btn-danger px-2 py-0">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No origins found.</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="addOriginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/admin/origins/add" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Origin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Origin Name / Cuisine</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Italian" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Country</label>
                        <input type="text" name="country" class="form-control" placeholder="e.g. Italy">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Flag Image URL</label>
                        <input type="url" name="flagUrl" class="form-control">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Origin</button>
                </div>
            </form>
        </div>
    </div>
</div>

{{#each origins}}
<div class="modal fade" id="editOriginModal{{this._id}}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/admin/origins/edit/{{this._id}}" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Origin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Origin Name / Cuisine</label>
                        <input type="text" name="name" class="form-control" value="{{this.name}}" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Country</label>
                        <input type="text" name="country" class="form-control" value="{{this.country}}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Flag Image URL</label>
                        <input type="url" name="flagUrl" class="form-control" value="{{this.flagUrl}}">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Update Origin</button>
                </div>
            </form>
        </div>
    </div>
</div>
{{/each}}