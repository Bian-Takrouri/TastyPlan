<div class="row mb-4 align-items-center">
    <div class="col">
        <h2 class="h3 font-weight-bold text-gray-800">Recipe Management</h2>
        <p class="text-muted mb-0">Add, edit, or remove recipes in the system.</p>
    </div>
    <div class="col-auto d-flex gap-2">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-sort me-1"></i> Sort
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-menu-item dropdown-item" href="/admin/recipes?sort=desc">Newest First</a></li>
                <li><a class="dropdown-menu-item dropdown-item" href="/admin/recipes?sort=asc">Oldest First</a></li>
            </ul>
        </div>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addRecipeModal">
            <i class="fas fa-plus fa-sm text-white-50 me-2"></i>Add New Recipe
        </button>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-white">
        <h6 class="m-0 font-weight-bold text-primary">All Recipes</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered align-middle" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Origin</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each recipes}}
                    <tr>
                        <td>{{add (add ../skip @index) 1}}</td>
                        <td>
                            {{#if this.imageUrl}}
                            <img src="{{this.imageUrl}}" alt="{{this.name}}" class="rounded"
                                style="width:50px;height:50px;object-fit:cover;">
                            {{else}}
                            <span class="badge bg-secondary">No Image</span>
                            {{/if}}
                        </td>
                        <td class="fw-bold">{{this.name}}</td>
                        <td><span class="badge bg-info text-dark">{{this.categoryId.name}}</span></td>
                        <td><span class="badge bg-secondary">{{this.originId.name}}</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-warning me-1" data-bs-toggle="modal"
                                data-bs-target="#editRecipeModal{{this._id}}">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <form action="/admin/recipes/delete/{{this._id}}" method="POST" class="d-inline"
                                onsubmit="return confirm('Are you sure you want to delete this recipe?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>

                    <div class="modal fade" id="editRecipeModal{{this._id}}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <form action="/admin/recipes/edit/{{this._id}}" method="POST">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit Recipe #{{this._id}}</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label">Recipe Name</label>
                                                <input type="text" name="name" class="form-control" value="{{this.name}}" required>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Category</label>
                                                <select name="categoryId" class="form-select" required>
                                                    <option value="{{this.categoryId._id}}">{{this.categoryId.name}}</option>
                                                    {{#each ../categories}}
                                                    <option value="{{this._id}}">{{this.name}}</option>
                                                    {{/each}}
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Origin / Cuisine</label>
                                                <select name="originId" class="form-select" required>
                                                    <option value="{{this.originId._id}}">{{this.originId.name}}</option>
                                                    {{#each ../origins}}
                                                    <option value="{{this._id}}">{{this.name}}</option>
                                                    {{/each}}
                                                </select>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label">Image URL</label>
                                                <input type="url" name="imageUrl" class="form-control" value="{{this.imageUrl}}">
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label">Instructions / Description</label>
                                                <textarea name="instructions" class="form-control" rows="4">{{this.instructions}}</textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-warning">Update Recipe</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    {{else}}
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No recipes found.</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="addRecipeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form action="/admin/recipes/add" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Recipe</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Recipe Name</label>
                            <input type="text" name="name" class="form-control" required placeholder="e.g., Margherita Pizza">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Category</label>
                            <select name="categoryId" class="form-select" required>
                                <option value="">Select Category...</option>
                                {{#each categories}}
                                <option value="{{this._id}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Origin / Cuisine</label>
                            <select name="originId" class="form-select" required>
                                <option value="">Select Origin...</option>
                                {{#each origins}}
                                <option value="{{this._id}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Image URL</label>
                            <input type="url" name="imageUrl" class="form-control" placeholder="https://example.com/image.jpg">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Instructions / Description</label>
                            <textarea name="instructions" class="form-control" rows="4" placeholder="Enter preparation steps here..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Recipe</button>
                </div>
            </form>
        </div>
    </div>
</div>

{{#if totalPages}}
<div class="d-flex justify-content-between align-items-center mt-4">
    <div class="text-muted">
        Page {{currentPage}} of {{totalPages}}
    </div>
    <nav>
        <ul class="pagination mb-0">
            {{#if (gt currentPage 1)}}
            <li class="page-item">
                <a class="page-link" href="/admin/recipes?page={{subtract currentPage 1}}&sort={{currentSort}}">
                    Previous
                </a>
            </li>
            {{/if}}

            {{#each (range 1 totalPages)}}
            <li class="page-item {{#if (eq this ../currentPage)}}active{{/if}}">
                <a class="page-link" href="/admin/recipes?page={{this}}&sort={{../currentSort}}">
                    {{this}}
                </a>
            </li>
            {{/each}}

            {{#if (lt currentPage totalPages)}}
            <li class="page-item">
                <a class="page-link" href="/admin/recipes?page={{add currentPage 1}}&sort={{currentSort}}">
                    Next
                </a>
            </li>
            {{/if}}
        </ul>
    </nav>
</div>
{{/if}}