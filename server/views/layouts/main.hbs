<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if title}}{{title}} - TastyPlan Admin{{else}}TastyPlan Admin{{/if}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            margin: 0;
            background-color: #f5f7fb;
            font-family: Arial, sans-serif;
        }
        .sidebar {
            min-height: 100vh;
            background-color: #212529;
            padding: 20px 15px;
        }

        .sidebar-title {
            color: #ffc107;
            font-size: 22px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 25px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #adb5bd;
            text-decoration: none;
            padding: 12px 14px;
            margin-bottom: 7px;
            border-radius: 8px;
            transition: 0.2s;
        }

        .sidebar-link:hover {
            color: white;
            background-color: #343a40;
        }

        .sidebar-link.active {
            color: white;
            background-color: #0d6efd;
        }

        .sidebar-link i {
            width: 20px;
            text-align: center;
        }

        .logout-link {
            color: #ff6b6b;
        }

        .logout-link:hover {
            color: white;
            background-color: #dc3545;
        }

        .main-content {
            padding: 30px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .page-title {
            margin: 0;
            font-weight: bold;
            color: #212529;
        }

        .admin-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        .stat-card {
            border: none;
            border-radius: 12px;
            color: white;
            padding: 22px;
            min-height: 130px;
        }

        .stat-number {
            font-size: 30px;
            font-weight: bold;
        }

        .stat-title {
            font-size: 14px;
            text-transform: uppercase;
            opacity: 0.9;
        }

        .btn {
            border-radius: 7px;
        }

        @media (max-width: 768px) {
            .sidebar {
                min-height: auto;
            }

            .main-content {
                padding: 20px 15px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
        }
    </style>
</head>

<body>
<div class="container-fluid">
    <div class="row">
        {{#if adminUser}}
            <!-- Sidebar -->
            <div class="col-md-2 sidebar">
                <div class="sidebar-title">
                    <i class="fa-solid fa-utensils"></i> TastyPlan
                </div>

                <a href="/admin/dashboard" class="sidebar-link {{#if (eq activePage 'dashboard')}}active{{/if}}">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>

                <a href="/admin/users" class="sidebar-link {{#if (eq activePage 'users')}}active{{/if}}">
                    <i class="fa-solid fa-users"></i> Users
                </a>

                <a href="/admin/recipes" class="sidebar-link {{#if (eq activePage 'recipes')}}active{{/if}}">
                    <i class="fa-solid fa-bowl-food"></i> Recipes
                </a>

                <a href="/admin/categories" class="sidebar-link {{#if (eq activePage 'categories')}}active{{/if}}">
                    <i class="fa-solid fa-layer-group"></i> Categories
                </a>

                <a href="/admin/origins" class="sidebar-link {{#if (eq activePage 'origins')}}active{{/if}}">
                    <i class="fa-solid fa-earth-americas"></i> Origins
                </a>

                <hr class="border-secondary">

                <a href="/admin/logout" class="sidebar-link logout-link">
                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                </a>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 main-content">
                {{{body}}}
            </div>
        {{else}}
            <div class="col-12">
                {{{body}}}
            </div>
        {{/if}}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>