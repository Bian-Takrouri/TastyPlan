<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        {{title}} - TastyPlan Dashboard
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background: #343a40;
            color: white;
        }

        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            padding: 10px 15px;
            display: block;
            border-radius: 4px;
            margin-bottom: 4px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            color: white;
            background: #495057;
        }
    </style>
</head>

<body>

    <div class="container-fluid">

        <div class="row">

            {{#if adminUser}}

            <div class="col-md-2 sidebar p-3">

                <h4 class="text-center py-2 text-warning">
                    TastyPlan Admin
                </h4>

                <hr>

                <a href="/admin/dashboard">
                    Dashboard Overview
                </a>

                <a href="/admin/recipes">
                    Manage Recipes
                </a>

                <a href="/admin/categories">
                    Manage Categories
                </a>

                <hr>

                <a
                    href="/admin/logout"
                    class="text-danger"
                >
                    Logout
                </a>

            </div>

            {{/if}}

            <div
                class="{{#if adminUser}}col-md-10{{else}}col-md-12{{/if}} p-4"
            >
                {{{body}}}
            </div>

        </div>

    </div>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    ></script>

</body>

</html>