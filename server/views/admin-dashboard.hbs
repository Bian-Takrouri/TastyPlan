<h2 class="h3 font-weight-bold text-gray-800 mb-4">System Overview</h2>

<div class="row">
    <!-- Total Recipes -->
    <div class="col-md-4 mb-4">
        <div class="card bg-primary text-white shadow py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-uppercase mb-1">Total Recipes</div>
                <div class="h2 mb-0 font-weight-bold">{{stats.totalRecipes}}</div>
            </div>
        </div>
    </div>

    <!-- Total Users -->
    <div class="col-md-4 mb-4">
        <div class="card bg-success text-white shadow py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-uppercase mb-1">Total Users</div>
                <div class="h2 mb-0 font-weight-bold">{{stats.totalUsers}}</div>
            </div>
        </div>
    </div>

    <!-- Total Categories -->
    <div class="col-md-4 mb-4">
        <div class="card bg-info text-white shadow py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-uppercase mb-1">Total Categories</div>
                <div class="h2 mb-0 font-weight-bold">{{stats.totalCategories}}</div>
            </div>
        </div>
    </div>
</div>