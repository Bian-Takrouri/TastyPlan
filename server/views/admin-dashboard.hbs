<div class="page-header">
    <div>
        <h2 class="page-title">Dashboard</h2>
        <p class="text-muted mb-0">Welcome to TastyPlan Admin Dashboard</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card bg-primary">
            <div class="stat-title">Total Recipes</div>
            <div class="stat-number">{{stats.totalRecipes}}</div>
            <i class="fa-solid fa-bowl-food mt-2"></i>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card bg-success">
            <div class="stat-title">Total Users</div>
            <div class="stat-number">{{stats.totalUsers}}</div>
            <i class="fa-solid fa-users mt-2"></i>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card bg-info">
            <div class="stat-title">Total Categories</div>
            <div class="stat-number">{{stats.totalCategories}}</div>
            <i class="fa-solid fa-layer-group mt-2"></i>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card bg-warning text-dark">
            <div class="stat-title">Total Origins</div>
            <div class="stat-number">{{stats.totalOrigins}}</div>
            <i class="fa-solid fa-earth-americas mt-2"></i>
        </div>
    </div>
</div>
