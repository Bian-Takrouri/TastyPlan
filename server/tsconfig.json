{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src",
    "scripts"
  ]
}